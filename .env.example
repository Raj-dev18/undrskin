# ==============================================================================
# UNDRSKIN Headless Storefront Environment Configuration Template
# NOTE: Never commit actual secret keys or API tokens to version control.
# ==============================================================================

# Shopify Store & Admin GraphQL API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_API_VERSION=2026-07

# Judge.me Product Reviews Integration (Server-Side)
# Retrieve your tokens from: Judge.me Admin > Settings > Integrations > View API tokens
JUDGEME_SHOP_DOMAIN=your-store.myshopify.com
JUDGEME_API_TOKEN=your_judgeme_private_api_token

# Optional: Public token for client-side widgets (if needed)
JUDGEME_PUBLIC_TOKEN=your_judgeme_public_api_token

# NextAuth Configuration
AUTH_SECRET=your_auth_secret_generate_with_npx_auth_secret
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_APPLE_ID=your_apple_client_id
AUTH_APPLE_SECRET=your_apple_client_secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number
