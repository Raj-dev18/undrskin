{% comment %}
  UndrSkin 3D Product Showcase Section (Homepage / Featured 3D Experience)
  Self-contained, homepage-friendly interactive 3D product viewer.
  Displays ONLY: Eyebrow/Title, 3D Canvas + What's Inside Modal, Colour & Size selectors.
{% endcomment %}

{{ 'undrskin-3d.css' | asset_url | stylesheet_tag }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
<script src="{{ 'undrskin-3d.js' | asset_url }}" defer></script>

{% assign current_variant = product.selected_or_first_available_variant %}

<section class="undrskin-3d-product" id="Undrskin3D-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="undrskin-container">
    
    <!-- Mobile Header (Shown on mobile viewports above 3D stage) -->
    <div class="undrskin-mobile-top-info">
      <div class="undrskin-eyebrow">
        {{ section.settings.eyebrow_text | default: "EVERYDAY TRIO · PACK OF 3" }}
      </div>
      <h1 class="undrskin-product-title">
        {{ product.title | default: "The Bamboo Hipster" }}
      </h1>
    </div>

    <!-- Hero Grid: Left (3D Viewer) / Right (Curated Product Options) -->
    <div class="undrskin-hero-grid">
      
      <!-- Left Column: Interactive 3D Stage -->
      <div class="undrskin-3d-stage-wrapper">
        <div class="undrskin-3d-stage">
          <canvas class="undrskin-3d-canvas" aria-label="Interactive 3D product view"></canvas>
          
          {% if product.featured_image %}
            <img 
              src="{{ product.featured_image | image_url: width: 800 }}" 
              alt="{{ product.title | escape }}" 
              class="undrskin-fallback-image"
              loading="eager"
            >
          {% endif %}

          <!-- Eye Button: WHAT'S INSIDE? positioned inside 3D viewer (top-right) -->
          {% if section.settings.show_exploded_btn %}
            <button type="button" class="undrskin-exploded-btn" aria-label="Open material and construction diagram">
              <span class="undrskin-eye-icon" aria-hidden="true">👁</span>
              <span>{{ section.settings.exploded_btn_label | default: "WHAT'S INSIDE?" }}</span>
            </button>
          {% endif %}
        </div>
      </div>

      <!-- Right Column: Product Title & Interactive Selectors Only -->
      <div class="undrskin-details-panel">
        
        <!-- Desktop Header -->
        <div class="undrskin-desktop-only">
          <div class="undrskin-eyebrow">
            {{ section.settings.eyebrow_text | default: "EVERYDAY TRIO · PACK OF 3" }}
          </div>
          <h1 class="undrskin-product-title">
            {{ product.title | default: "The Bamboo Hipster" }}
          </h1>
        </div>

        <!-- Optional Price Display (Toggleable via section settings) -->
        {% if section.settings.show_price %}
          <div class="undrskin-price-wrapper">
            <span class="undrskin-price">
              {{ current_variant.price | money }}
            </span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="undrskin-compare-price">
                {{ current_variant.compare_at_price | money }}
              </span>
              <span class="undrskin-badge-save">
                SAVE {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%
              </span>
            {% endif %}
          </div>
        {% endif %}

        <!-- Optional Description (Toggleable via section settings) -->
        {% if section.settings.show_description %}
          {% if product.description != blank %}
            <div class="undrskin-description">
              {{ product.description }}
            </div>
          {% endif %}
        {% endif %}

        <!-- Product Options Form (Colour & Size Selectors) -->
        <form method="post" action="/cart/add" class="undrskin-variant-form" data-type="add-to-cart-form">
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {% assign has_color_option = false %}
          {% assign has_size_option = false %}

          {% for option in product.options_with_values %}
            {% assign option_name_lower = option.name | downcase %}

            {% if option_name_lower contains 'color' or option_name_lower contains 'colour' or option_name_lower contains 'shade' or option_name_lower contains 'colourway' %}
              {% assign has_color_option = true %}
              <div class="undrskin-option-group">
                <div class="undrskin-option-header">
                  <span>Colour: <strong id="cwName">{{ option.selected_value | default: option.values.first }}</strong></span>
                </div>
                <div class="undrskin-swatch-group" id="dots">
                  {% for val in option.values %}
                    {% assign val_lower = val | downcase %}
                    {% assign hex = '#B96F73' %}
                    {% assign c_idx = 0 %}

                    {% if val_lower contains 'wine' or val_lower contains 'maroon' or val_lower contains 'red' %}
                      {% assign hex = '#7E1626' %}
                      {% assign c_idx = 1 %}
                    {% elsif val_lower contains 'black' or val_lower contains 'onyx' or val_lower contains 'dark' %}
                      {% assign hex = '#1B1717' %}
                      {% assign c_idx = 2 %}
                    {% elsif val_lower contains 'sand' or val_lower contains 'beige' or val_lower contains 'nude' %}
                      {% assign hex = '#E2BC96' %}
                      {% assign c_idx = 3 %}
                    {% elsif val_lower contains 'rose' or val_lower contains 'pink' or val_lower contains 'dusty' %}
                      {% assign hex = '#B96F73' %}
                      {% assign c_idx = 0 %}
                    {% else %}
                      {% assign c_idx = forloop.index0 | modulo: 4 %}
                      {% if c_idx == 0 %}{% assign hex = '#B96F73' %}
                      {% elsif c_idx == 1 %}{% assign hex = '#7E1626' %}
                      {% elsif c_idx == 2 %}{% assign hex = '#1B1717' %}
                      {% else %}{% assign hex = '#E2BC96' %}{% endif %}
                    {% endif %}

                    <button 
                      type="button" 
                      class="undrskin-swatch-btn dot {% if forloop.first %}is-active is-on{% endif %}" 
                      data-value="{{ val | escape }}" 
                      data-c="{{ c_idx }}" 
                      data-hex="{{ hex }}" 
                      aria-label="{{ val | escape }}"
                    >
                      <span class="swatch-inner" style="background-color: {{ hex }};"></span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% elsif option_name_lower contains 'size' %}
              {% assign has_size_option = true %}
              <div class="undrskin-option-group">
                <div class="undrskin-option-header">
                  <span>Size</span>
                  {% if section.settings.show_size_guide %}
                    <button type="button" class="undrskin-size-guide-trigger">Size Guide</button>
                  {% endif %}
                </div>
                <div class="undrskin-size-options" id="sizes">
                  {% for val in option.values %}
                    <button 
                      type="button" 
                      class="undrskin-size-btn size {% if option.selected_value == val or forloop.first %}is-active is-on{% endif %}" 
                      data-value="{{ val | escape }}"
                      data-s="{{ val | escape }}"
                    >
                      {{ val }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          <!-- Fallback options if product has no Shopify options configured -->
          {% unless has_color_option %}
            <div class="undrskin-option-group">
              <div class="undrskin-option-header">
                <span>Colour: <strong id="cwName">Dusty Rose</strong></span>
              </div>
              <div class="undrskin-swatch-group" id="dots">
                <button type="button" class="undrskin-swatch-btn dot is-active is-on" data-value="Dusty Rose" data-c="0" data-hex="#B96F73" aria-label="Dusty Rose">
                  <span class="swatch-inner" style="background-color: #B96F73;"></span>
                </button>
                <button type="button" class="undrskin-swatch-btn dot" data-value="Maroon" data-c="1" data-hex="#7E1626" aria-label="Maroon">
                  <span class="swatch-inner" style="background-color: #7E1626;"></span>
                </button>
                <button type="button" class="undrskin-swatch-btn dot" data-value="Onyx Black" data-c="2" data-hex="#1B1717" aria-label="Onyx Black">
                  <span class="swatch-inner" style="background-color: #1B1717;"></span>
                </button>
                <button type="button" class="undrskin-swatch-btn dot" data-value="Nude Sand" data-c="3" data-hex="#E2BC96" aria-label="Nude Sand">
                  <span class="swatch-inner" style="background-color: #E2BC96;"></span>
                </button>
              </div>
            </div>
          {% endunless %}

          {% unless has_size_option %}
            <div class="undrskin-option-group">
              <div class="undrskin-option-header">
                <span>Size</span>
                {% if section.settings.show_size_guide %}
                  <button type="button" class="undrskin-size-guide-trigger">Size Guide</button>
                {% endif %}
              </div>
              <div class="undrskin-size-options" id="sizes">
                <button type="button" class="undrskin-size-btn size" data-value="XS" data-s="XS">XS</button>
                <button type="button" class="undrskin-size-btn size" data-value="S" data-s="S">S</button>
                <button type="button" class="undrskin-size-btn size is-active is-on" data-value="M" data-s="M">M</button>
                <button type="button" class="undrskin-size-btn size" data-value="L" data-s="L">L</button>
                <button type="button" class="undrskin-size-btn size" data-value="XL" data-s="XL">XL</button>
                <button type="button" class="undrskin-size-btn size" data-value="XXL" data-s="XXL">XXL</button>
              </div>
            </div>
          {% endunless %}

          <!-- Optional Add to Bag CTA Button (Toggleable via section settings) -->
          {% if section.settings.show_cta %}
            <button type="submit" id="addBtn" class="undrskin-add-to-bag-btn" {% unless current_variant.available %}disabled{% endunless %}>
              <span>
                {% if current_variant.available %}
                  ADD TO BAG
                {% else %}
                  SOLD OUT
                {% endif %}
              </span>
            </button>
          {% endif %}
        </form>

        <!-- Optional Accordions (Toggleable via section settings) -->
        {% if section.settings.show_accordions %}
          <div class="undrskin-accordions-wrapper">
            <div class="undrskin-accordion-item is-active">
              <button type="button" class="undrskin-accordion-header">
                <span>FIBRE & MATERIAL</span>
                <span class="undrskin-accordion-icon">+</span>
              </button>
              <div class="undrskin-accordion-content">
                <p>95% organic bamboo viscose · 5% spandex. Spun from natural cellulose grass for ultra-smooth skin contact.</p>
              </div>
            </div>

            <div class="undrskin-accordion-item">
              <button type="button" class="undrskin-accordion-header">
                <span>FIT & CONSTRUCTION</span>
                <span class="undrskin-accordion-icon">+</span>
              </button>
              <div class="undrskin-accordion-content">
                <p>Self-fabric elastic-free waistband with full seat coverage that lays flat without pinching or digging in.</p>
              </div>
            </div>

            <div class="undrskin-accordion-item">
              <button type="button" class="undrskin-accordion-header">
                <span>BREATHABILITY & CARE</span>
                <span class="undrskin-accordion-icon">+</span>
              </button>
              <div class="undrskin-accordion-content">
                <p>Moisture-wicking, temperature regulating, and machine washable at 30°C. Tumble dry low.</p>
              </div>
            </div>
          </div>
        {% endif %}

      </div>
    </div>

  </div>

  <!-- "WHAT'S INSIDE?" Technical Inspection Overlay -->
  <div class="undrskin-exploded-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="undrskin-exploded-content">
      <div class="undrskin-exploded-header">
        <h3 class="undrskin-exploded-title">Material & Construction Inspection</h3>
        <button type="button" class="undrskin-exploded-close" aria-label="Close inspection overlay">&times;</button>
      </div>
      
      <div class="undrskin-exploded-body">
        <div class="undrskin-schematic-card">
          <div class="undrskin-schematic-badge">Bamboo Hipster Construction</div>
          <p class="undrskin-schematic-sub">Interactive 4-layer comfort breakdown</p>
        </div>

        <div class="undrskin-annotation-grid">
          <!-- Annotation 1: Main Fabric -->
          <div class="undrskin-annotation-card">
            <div class="undrskin-card-num">1</div>
            <div>
              <h4>Main Bamboo Viscose</h4>
              <p>95% Organic Bamboo Viscose woven for ultra-soft, breathable skin contact.</p>
            </div>
          </div>

          <!-- Annotation 2: Self Waistband -->
          <div class="undrskin-annotation-card">
            <div class="undrskin-card-num">2</div>
            <div>
              <h4>Self-Fabric Waistband</h4>
              <p>Double-layered bamboo fabric holding firm without elastic digging or red marks.</p>
            </div>
          </div>

          <!-- Annotation 3: Spandex Core -->
          <div class="undrskin-annotation-card">
            <div class="undrskin-card-num">3</div>
            <div>
              <h4>5% Spandex Elastic Matrix</h4>
              <p>Micro-elastics providing 4-way flexibility that retains shape wear after wear.</p>
            </div>
          </div>

          <!-- Annotation 4: Gusset -->
          <div class="undrskin-annotation-card">
            <div class="undrskin-card-num">4</div>
            <div>
              <h4>Breathable Hygiene Gusset</h4>
              <p>Dual-layer moisture-wicking bamboo lining for all-day freshness.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Size Guide Modal -->
  {% if section.settings.show_size_guide %}
    <div class="undrskin-size-guide-modal" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="undrskin-size-guide-content">
        <div class="undrskin-size-guide-header">
          <h3>Size Guide & Body Measurements</h3>
          <button type="button" class="undrskin-size-guide-close" aria-label="Close size guide">&times;</button>
        </div>
        <div class="undrskin-size-guide-body">
          <p>Measurements refer to body size, not garment dimensions. If between sizes, we recommend sizing up for a relaxed fit.</p>
          <table class="undrskin-size-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Waist (in)</th>
                <th>Hips (in)</th>
                <th>Waist (cm)</th>
                <th>Hips (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>XS</strong></td>
                <td>24" – 26"</td>
                <td>34" – 36"</td>
                <td>61 – 66 cm</td>
                <td>86 – 91 cm</td>
              </tr>
              <tr>
                <td><strong>S</strong></td>
                <td>26" – 28"</td>
                <td>36" – 38"</td>
                <td>66 – 71 cm</td>
                <td>91 – 97 cm</td>
              </tr>
              <tr class="is-highlight">
                <td><strong>M</strong></td>
                <td>28" – 30"</td>
                <td>38" – 40"</td>
                <td>71 – 76 cm</td>
                <td>97 – 102 cm</td>
              </tr>
              <tr>
                <td><strong>L</strong></td>
                <td>30" – 33"</td>
                <td>40" – 43"</td>
                <td>76 – 84 cm</td>
                <td>102 – 109 cm</td>
              </tr>
              <tr>
                <td><strong>XL</strong></td>
                <td>33" – 36"</td>
                <td>43" – 46"</td>
                <td>84 – 91 cm</td>
                <td>109 – 117 cm</td>
              </tr>
              <tr>
                <td><strong>XXL</strong></td>
                <td>36" – 39"</td>
                <td>46" – 49"</td>
                <td>91 – 99 cm</td>
                <td>117 – 124 cm</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Product Variants JSON Data -->
  <script type="application/json" data-product-variants-json>
    {{ product.variants | json }}
  </script>
</section>

<!-- Product Collection Grid Section -->
{% if section.settings.show_collection_grid %}
  <section class="undrskin-collection-section">
    <div class="undrskin-container">
      <div class="undrskin-collection-header">
        <h2 class="undrskin-collection-title">{{ section.settings.collection_title | default: "The Collection" }}</h2>
        <p>Pick your favourite trios and everyday essentials</p>
      </div>

      <div class="undrskin-product-grid">
        {% assign collection_handle = section.settings.collection | default: 'all' %}
        {% for card_product in collections[collection_handle].products limit: 7 %}
          <a href="{{ card_product.url }}" class="undrskin-card">
            <div class="undrskin-card-image-wrapper">
              {% if card_product.featured_image %}
                <img src="{{ card_product.featured_image | image_url: width: 600 }}" alt="{{ card_product.title | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="undrskin-card-details">
              <h3 class="undrskin-card-title">{{ card_product.title }}</h3>
              <div class="undrskin-card-price">{{ card_product.price | money }}</div>
            </div>
          </a>
        {% else %}
          {% for i in (1..7) %}
            <div class="undrskin-card">
              <div class="undrskin-card-image-wrapper" style="background:#E2BC97; display:grid; place-items:center;">
                <span style="font-family:var(--us-font-display); font-size:1.5rem; color:#1B1717;">UndrSkin</span>
              </div>
              <div class="undrskin-card-details">
                <h3 class="undrskin-card-title">Everyday Trio Pack {{ i }}</h3>
                <div class="undrskin-card-price">₹1,999</div>
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "UndrSkin 3D Product",
  "tag": "section",
  "class": "undrskin-3d-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Subtitle",
      "default": "EVERYDAY TRIO · PACK OF 3"
    },
    {
      "type": "checkbox",
      "id": "show_exploded_btn",
      "label": "Show Material Inspection Button (👁)",
      "default": true
    },
    {
      "type": "text",
      "id": "exploded_btn_label",
      "label": "Inspection Button Label",
      "default": "WHAT'S INSIDE?"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Product Price",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Product Description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Add to Bag Button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show Size Guide Link & Modal",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_accordions",
      "label": "Show Product Accordions",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_collection_grid",
      "label": "Show Collection Product Grid",
      "default": false
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection Grid Title",
      "default": "The Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    }
  ],
  "presets": [
    {
      "name": "UndrSkin 3D Product",
      "category": "Product"
    }
  ]
}
{% endschema %}
